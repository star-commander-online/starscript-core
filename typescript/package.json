{
  "name": "@star-commander/starscript-core",
  "version": "0.1.0",
  "description": "Go-based StarScript interpreter compiled to WASM with TypeScript bindings",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wasm_exec.js": "./dist/wasm_exec.js",
    "./starscript.wasm": "./dist/starscript.wasm"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "copy-assets": "node scripts/copy-assets.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
