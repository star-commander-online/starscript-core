{
  "name": "@star-commander-online/starscript-core",
  "version": "1.0.6",
  "description": "TypeScript bridge for the Go StarScript interpreter for Star Commander Online",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/star-commander-online/starscript-core"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./starscript.wasm": "./dist/starscript.wasm"
  },
  "sideEffects": [
    "./dist/wasm_exec.js"
  ],
  "scripts": {
    "build": "node build.mjs",
    "clean": "rimraf dist",
    "prepack": "npm run clean && npm run build"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "rimraf": "^6.1.3"
  },
  "keywords": [
    "starscript",
    "typescript",
    "go",
    "wasm",
    "interpreter",
    "starcommander"
  ]
}